{
  "name": "reitrn-warehouse",
  "version": "1.2.3",
  "description": "reitrn. Warehouse — one desktop station app for the reitrn warehouse: inspection, scanning, webcam capture and built-in label printing. Pointed at Lite (portal) or Hub (ReturnHub) by config.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.reitrn.warehouse",
    "productName": "reitrn Warehouse",
    "copyright": "reitrn.",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "reitrn-warehouse-setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "reitrn-warehouse-setup.exe"
    },
    "files": [
      "main.js",
      "printer.js",
      "app-preload.js",
      "settings-preload.js",
      "settings/**/*",
      "lock-preload.js",
      "lock/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "brand.js",
      "brand.json",
      "splash/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "reitrn",
      "repo": "reitrn-warehouse"
    }
  }
}
